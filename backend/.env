# ========================================================
# Khet2Kart Backend Environment Configuration
# ========================================================

PORT=5000

# To send real cellular SMS directly to mobile phones in India,
# provide ANY ONE of the following API keys:

# Option A: Fast2SMS (Recommended for India - Quick setup)
# Get free API key from: https://www.fast2sms.com/
FAST2SMS_API_KEY=

# Option B: 2Factor.in (India OTP SMS)
# Get API key from: https://2factor.in/
TWOFACTOR_API_KEY=

# Option C: Twilio (Global SMS)
# Get credentials from: https://www.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
